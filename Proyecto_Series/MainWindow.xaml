<Window x:Class="CatalogoSeries.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MySeries List" Height="650" Width="1000"
        Background="#141414" FontFamily="Segoe UI" Foreground="White">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="BIBLIOTECA" FontWeight="Bold" FontSize="18" Foreground="#E50914" Margin="0,0,0,10"/>
        <Border Grid.Row="1" Background="#202020" CornerRadius="5">
            <StackPanel Margin="10">
                <TextBlock Text="Categorías" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="Gray"/>
                <ListBox x:Name="lbCategorias" Background="Transparent" BorderThickness="0" Foreground="White"
                         DisplayMemberPath="Nombre" SelectedValuePath="Id"
                         SelectionChanged="LbCategorias_SelectionChanged"
                         FontSize="14" Padding="5"/>
                <Separator Background="#444" Margin="0,10"/>
                <TextBlock x:Name="txtStats" Text="Total Series: 0" FontSize="12" Foreground="#AAA"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="15,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,15">
                <TextBlock Text="Mis Series" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBox x:Name="txtBuscar" Width="250" HorizontalAlignment="Right" 
                         Tag="Buscar..." TextChanged="TxtBuscar_TextChanged"/>
            </Grid>

            <DataGrid x:Name="dgSeries" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#1F1F1F" RowBackground="#1F1F1F" AlternatingRowBackground="#252525"
                      Foreground="White" BorderThickness="0" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333"
                      SelectionChanged="DgSeries_SelectionChanged">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#141414"/>
                        <Setter Property="Foreground" Value="Gray"/>
                        <Setter Property="Padding" Value="10,5"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Plataforma" Binding="{Binding Plataforma}" Width="100"/>
                    <DataGridTextColumn Header="Año" Binding="{Binding Anio}"/>
                    <DataGridTextColumn Header="Nota" Binding="{Binding Nota}" FontWeight="Bold" Foreground="#E50914"/>
                    <DataGridCheckBoxColumn Header="Visto" Binding="{Binding EstaVisto}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Background="#202020" Margin="5,0,0,0">
            <Border Background="#E50914" Height="5" VerticalAlignment="Top"/>
            <StackPanel Margin="20">
                <TextBlock Text="Detalles de Serie" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                <Label Content="Título:" Foreground="#AAA"/>
                <TextBox x:Name="txtTitulo" Margin="0,0,0,10"/>

                <Label Content="Categoría:" Foreground="#AAA"/>
                <ComboBox x:Name="cbCategoria" Margin="0,0,0,10" Height="30" DisplayMemberPath="Nombre" SelectedValuePath="Id"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <Label Content="Año:" Foreground="#AAA"/>
                        <TextBox x:Name="txtAnio"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <Label Content="Nota (0-10):" Foreground="#AAA"/>
                        <TextBox x:Name="txtNota"/>
                    </StackPanel>
                </Grid>

                <Label Content="Plataforma:" Foreground="#AAA" Margin="0,10,0,0"/>
                <ComboBox x:Name="cbPlataforma" IsEditable="True" Margin="0,0,0,10" Height="30">
                    <ComboBoxItem Content="Netflix"/>
                    <ComboBoxItem Content="HBO Max"/>
                    <ComboBoxItem Content="Disney+"/>
                    <ComboBoxItem Content="Crunchyroll"/>
                </ComboBox>

                <CheckBox x:Name="chkVisto" Content="Ya la he visto" Foreground="White" Margin="0,15"/>

                <Button x:Name="btnGuardar" Content="GUARDAR" Height="40" Margin="0,20,0,10"
                        Background="#E50914" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"
                        Click="BtnGuardar_Click"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnNuevo" Grid.Column="0" Content="Limpiar" Margin="0,0,5,0" Height="30" 
                            Background="#444" Foreground="White" BorderThickness="0" Click="BtnNuevo_Click"/>
                    <Button x:Name="btnEliminar" Grid.Column="1" Content="Eliminar" Margin="5,0,0,0" Height="30" 
                            Background="#444" Foreground="White" BorderThickness="0" Click="BtnEliminar_Click"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>